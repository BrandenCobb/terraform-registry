{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws-us-gov:iam::ACCOUNT_ID:oidc-provider/oidc.eks.us-gov-west-1.amazonaws.com/id/OIDC_ID"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "oidc.eks.us-gov-west-1.amazonaws.com/id/OIDC_ID:sub": "system:serviceaccount:terraform-registry:terraform-registry",
          "oidc.eks.us-gov-west-1.amazonaws.com/id/OIDC_ID:aud": "sts.amazonaws.com"
        }
      }
    }
  ]
}
