{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:HeadBucket"
      ],
      "Resource": [
        "arn:aws-us-gov:s3:::terraform-registry",
        "arn:aws-us-gov:s3:::terraform-registry/*"
      ]
    }
  ]
}
