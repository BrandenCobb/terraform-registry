# Example .terraformrc for using the S3-backed provider registry

provider_installation {
  network_mirror {
    url = "https://terraform-registry.internal.example.com/"
    include = ["*/*"]
  }

  # Optional: fallback to public registry
  # direct {
  #   exclude = ["*/*"]
  # }
}

# Disable checkpoint calls to HashiCorp
disable_checkpoint = true
disable_checkpoint_signature = false
