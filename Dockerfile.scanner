FROM --platform=$BUILDPLATFORM golang:1.27.0-alpine AS builder

ARG VERSION=dev
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /app
COPY registry-server/go.mod registry-server/go.sum ./registry-server/
RUN cd registry-server && go mod download
COPY registry-server/*.go ./registry-server/
COPY registry-server/ui/ ./registry-server/ui/
RUN cd registry-server && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags="-w -s -X main.version=${VERSION}" -o /app/terraform-registry .
COPY cmd/tfreg/go.mod ./cmd/tfreg/
COPY cmd/tfreg/*.go ./cmd/tfreg/
RUN cd cmd/tfreg && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags="-w -s -X main.version=${VERSION}" -o /app/tfreg .

# Trivy v0.73.0 pins `go 1.26.3` and builds against the pre-1.27 `encoding/json/v2`
# experiment (it relies on `json.SkipFunc`, removed in Go 1.27). Keep this stage on
# 1.26.x until a Trivy release compatible with Go 1.27 is available.
FROM --platform=$BUILDPLATFORM golang:1.26.6-alpine AS trivy-builder
ARG TARGETOS=linux
ARG TARGETARCH
RUN apk add --no-cache git
RUN git clone --branch v0.73.0 --depth 1 https://github.com/aquasecurity/trivy.git /src
WORKDIR /src
RUN go get github.com/go-git/go-git/v5@v5.19.2 oras.land/oras-go/v2@v2.6.2 golang.org/x/text@v0.41.0 golang.org/x/mod@v0.40.0 && \
    go mod tidy && GOEXPERIMENT=jsonv2 CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
        -ldflags="-w -s -X github.com/aquasecurity/trivy/pkg/version/app.ver=0.73.0" \
        -o /trivy ./cmd/trivy
FROM bridgecrew/checkov:3.3.11@sha256:e5e308e713725e73f517e4cb85b39d467f1e047204c174fb15eb444c27ffb745

ARG VERSION=dev
LABEL org.opencontainers.image.source="https://github.com/BrandenCobb/terraform-registry" \
      org.opencontainers.image.description="Terraform registry with isolated-workspace Trivy and Checkov artifact scanning" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      io.terraform-registry.scanners="trivy=0.73.0,checkov=3.3.11"

USER root
COPY --from=builder --chown=65534:65534 /app/terraform-registry /app/terraform-registry
COPY --from=builder /app/tfreg /usr/local/bin/tfreg
COPY --from=trivy-builder /trivy /usr/local/bin/trivy
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m pip install --no-cache-dir --upgrade \
        'setuptools>=82.0.0' 'GitPython>=3.1.58' 'aiohttp>=3.14.3,<3.15' \
        'jaraco.context>=6.1.0' 'packaging>=24,<27' 'urllib3>=2.7.0' 'wheel>=0.46.2' && \
    python3 -c 'from importlib.metadata import distribution; p=distribution("checkov")._path/"METADATA"; s=p.read_text(); s=s.replace("Requires-Dist: aiohttp<3.14.0,>=3.8.0", "Requires-Dist: aiohttp<3.15,>=3.14.3"); s=s.replace("Requires-Dist: packaging<24.0,>=23.0", "Requires-Dist: packaging<27,>=24"); p.write_text(s)' && \
    python3 -m pip check && \
    rm -f /usr/local/bin/helm /usr/bin/kustomize && \
    mkdir -p /var/lib/terraform-registry/providers /var/lib/terraform-registry/modules \
        /var/lib/terraform-registry/tmp /var/lib/terraform-registry/trivy-cache && \
    chown -R 65534:65534 /var/lib/terraform-registry /app && \
    chmod 0755 /app/terraform-registry /usr/local/bin/tfreg /usr/local/bin/trivy

WORKDIR /app
EXPOSE 8080
VOLUME ["/var/lib/terraform-registry"]
USER 65534:65534
ENV STORAGE_PATH=/var/lib/terraform-registry \
    BASE_URL=http://localhost:8080 \
    PORT=8080 \
    SCANNING_ENABLED=true \
    TRIVY_PATH=/usr/local/bin/trivy \
    CHECKOV_PATH=/usr/local/bin/checkov \
    TRIVY_CACHE_DIR=/var/lib/terraform-registry/trivy-cache \
    HOME=/tmp
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8080/health', timeout=3).read()"]
ENTRYPOINT ["/app/terraform-registry"]
